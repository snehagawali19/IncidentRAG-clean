# ─────────────────────────────────────────────────────────────────────────────
# IncidentRAG — Environment Variable Template
# Copy this file to .env and fill in real values.  Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM API Keys ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_UTILITY_MODEL=openai/gpt-4o-mini
OPENROUTER_REASONING_MODEL=openai/gpt-4o-mini
REASONING_MAX_OUTPUT_TOKENS=2000
RERANKER_MIN_SCORE=0.0
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_HTTP_REFERER=http://localhost:8000
OPENROUTER_APP_TITLE=IncidentRAG

# ── Model Names ───────────────────────────────────────────────────────────────
# Primary reasoning model (Anthropic)
ANTHROPIC_REASONING_MODEL=claude-opus-4-5

# Secondary / fallback model (OpenAI)
OPENAI_REASONING_MODEL=gpt-4o-mini

# Embedding model (OpenAI)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Reranker model identifier (sentence-transformers)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Service URLs ───────────────────────────────────────────────────────────────
# Neo4j (graph database)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=incidentrag

# Qdrant (vector database)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Redis (caching + feedback queue)
REDIS_URL=redis://localhost:6379/0

# GitHub public issue source (read-only; token is optional)
GITHUB_OWNER=argoproj
GITHUB_REPO=argo-cd
GITHUB_TOKEN=
GITHUB_MAX_RESULTS=2
# The provider enforces a hard maximum candidate pool of 10.
GITHUB_CANDIDATE_LIMIT=10
GITHUB_UPDATED_WITHIN_DAYS=90
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_REQUEST_TIMEOUT_SECONDS=10
DEMO_MODE=true
EXECUTION_ENABLED=false
INCIDENTRAG_API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:8501,http://localhost:8000

# OpenTelemetry Collector (observability)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=incidentrag

# ── Collection / Index Names ───────────────────────────────────────────────────
QDRANT_COLLECTION_NAME=incidentrag_chunks
QDRANT_EMBEDDING_DIM=1536

# ── Application Settings ───────────────────────────────────────────────────────
# Environment tag for all traces/metrics
APP_ENVIRONMENT=development

# Token budget per inference call (hard ceiling)
MAX_CONTEXT_TOKENS=180000

# Top-k chunks returned after reranking
RETRIEVAL_TOP_K=10

# BM25 candidate pool before reranking
BM25_CANDIDATE_K=50

# Dense candidate pool before reranking
DENSE_CANDIDATE_K=50

# RAGAS evaluation dataset path
EVAL_DATASET_PATH=data/ground_truth/eval_set.jsonl

# Minimum RAGAS faithfulness score to pass CI gate
EVAL_MIN_FAITHFULNESS=0.85

# Diskcache directory for embeddings
DISKCACHE_DIR=.cache/embeddings
