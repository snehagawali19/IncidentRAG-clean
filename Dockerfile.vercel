FROM python:3.12-slim
WORKDIR /app
ENV PYTHONPATH=/app/src PYTHONUNBUFFERED=1 PORT=8080
RUN pip install --no-cache-dir streamlit==1.49.1 httpx==0.28.1 python-dotenv==1.1.1
COPY src/ src/
RUN useradd --create-home --uid 10001 incidentrag && chown -R incidentrag:incidentrag /app
USER 10001
EXPOSE 8080
CMD ["sh", "-c", "exec streamlit run src/incidentrag/approval/ui/streamlit_app.py --server.address=0.0.0.0 --server.port=${PORT:-8080} --server.headless=true --browser.gatherUsageStats=false"]
